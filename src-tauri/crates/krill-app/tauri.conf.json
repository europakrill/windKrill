{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "windKrill",
  "version": "0.1.0",
  "identifier": "com.windkrill.app",
  "build": {
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "windKrill",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
